        "as7343_F3",
        "as7343_F4",
        "as7343_F5",
        "as7343_FY",
        "as7343_FXL",
        "as7343_F6",
        "as7343_F7",
        "as7343_F8",
        "as7343_NIR",
        "as7343_VIS",
        "as7343_FD",
